# ================================
# Environment Variables
# ================================

# Maintenance Mode
# Set to "true" to enable maintenance page
# Set to "false" to run the website normally
VITE_MAINTENANCE_MODE=false

# API Backend URL
# Development: http://localhost:3000/api/v1
# Production: https://backendpersonaltrainer-production.up.railway.app/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Supabase (login real) — Project Settings > API en supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
