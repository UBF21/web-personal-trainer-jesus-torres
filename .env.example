# ================================
# Environment Variables
# ================================

# Maintenance Mode
# Set to "true" to enable maintenance page
# Set to "false" to run the website normally
VITE_MAINTENANCE_MODE=false

# Supabase — Project Settings > API en supabase.com
# (ya no hay backend Express de por medio: el frontend habla directo con
# Supabase, protegido por políticas RLS por rol)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
